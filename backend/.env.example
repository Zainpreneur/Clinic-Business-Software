# SQLite (default, zero-config)
DATABASE_URL="file:./dev.db"

# To use Postgres instead (see docker-compose.yml at repo root):
# 1. In prisma/schema.prisma set datasource provider to "postgresql"
# 2. DATABASE_URL="postgresql://clinic:clinic@localhost:5432/clinic?schema=public"

PORT=4000
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
